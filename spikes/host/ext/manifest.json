{ "manifest_version": 3, "name": "Swift Canvas host spike", "version": "0.0.1",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "tabs"], "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "sandbox": { "pages": ["frame.html"] },
  "content_security_policy_sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline'; object-src 'self'" }
