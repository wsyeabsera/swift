        "minimum": 0,
        "type": "integer"
      },
      "source": {
        "$ref": "#/$defs/Source"
      }
    },
    "required": [
      "run",
      "seq",
      "source",
      "event"
    ],
    "title": "LiveEnvelope",
    "type": "object"
  },
