{"id":"orders","description":"Orders with status, totals and dates.","fields":{
"id":{"kind":"number","min":10000,"max":99999,"decimals":0,"format":"raw"},
"status":{"kind":"pick","values":{"en":["Paid","Shipped","Delivered","Refunded","Pending"],"de":["Bezahlt","Versendet","Zugestellt","Erstattet","Ausstehend"]}},
"total":{"kind":"number","min":9,"max":940,"decimals":2,"format":"currency"},
"items":{"kind":"number","min":1,"max":9,"decimals":0,"format":"int"},
"date":{"kind":"date","from":"2026-08-01","to":"2026-10-31"}},
"records":{"order":["id","status","total","items","date"]},"templates":{"label":"Order #{id}"}}
