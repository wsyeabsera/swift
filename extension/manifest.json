{ "manifest_version": 3, "name": "Swift Canvas", "version": "0.0.1", "description": "AI-native design tool: open the app in a tab.",
  "background": { "service_worker": "background.js" }, "action": { "default_title": "Open Swift Canvas" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" } }
