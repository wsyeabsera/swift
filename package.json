{
  "name": "swift-canvas",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts && cp app/src/canvas/bridge-frame.js extension/frame.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:changed": "vitest --changed",
    "e2e:contrast": "node e2e/contrast.mjs",
    "e2e:radii": "node e2e/radii.mjs",
    "helper": "cargo run -q -p swift-canvas-helper",
    "helper:test": "cargo test -q -p swift-canvas-helper",
    "e2e": "cargo build -q -p swift-canvas-helper && node e2e/prepare-test.mjs && node e2e/smoke.mjs",
    "e2e:clean": "node -e \"import('./e2e/env.mjs').then((m) => m.cleanTestPorts())\"",
    "e2e:mcp": "cargo build -q -p swift-canvas-helper && node e2e/mcp.mjs",
    "gen:core": "cargo run -q -p swift-canvas-core --example gen",
    "e2e:errors": "cargo build -q -p swift-canvas-helper && node e2e/fake-errors.mjs",
    "test:tools": "node --test tools/swift-canvas.test.mjs",
    "test:plugin": "node tools/validate-plugin.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.64.1",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
